{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@types/*": ["app/static/js/types/*"]
    }
  },
  "include": [
    "app/static/js/**/*.js",
    "app/static/js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".venv"
  ]
}
