# Development Dockerfile for Notees Backend
# Supports hot-reload with mounted volumes.

FROM ghcr.io/astral-sh/uv:python3.13-bookworm

# Set environment variables
ENV PYTHONDONTWRYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Install PostgreSQL 17 client repo for pg_dump matching the server version
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg \
    postgresql-client-common \
    && wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - \
    && echo "deb http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    postgresql-client-17 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-xlib-2.0-0 \
    libffi-dev \
    libcairo2 \
    fonts-liberation \
    fonts-lmodern \
    gosu \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency metadata and install all dependencies (including dev)
COPY uv.lock pyproject.toml ./
RUN uv sync --all-groups

# Copy application code (will be overridden by volume mount in dev)
COPY app/ ./app/

# Create data and logs directories
RUN mkdir -p /app/data /app/logs

# Copy entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose port
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app"]
