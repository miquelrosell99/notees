{
  "name": "@notees/export",
  "version": "0.1.0-m1",
  "description": "Notees export engine: content tokens → Markdown projection (frontmatter, bundle, workspace manifest).",
  "license": "AGPL-3.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
