{
  "id": "notees.library",
  "name": "Library",
  "version": "1.0.0",
  "description": "Source management views: browse sources by class (books, papers, articles, theses, documents, movies) and authors, with table/card modes, Work→Edition grouping, covers, and add-by-identifier (ISBN/DOI lookup).",
  "author": "Notees",
  "license": "AGPL-3.0",
  "permissions": ["read_nodes", "write_nodes", "read_properties", "write_properties", "settings", "router"],
  "backend": {
    "entrypoint": "app.plugins.builtin.library.setup:setup"
  },
  "frontend": {
    "entrypoint": "./dist/plugin.js"
  },
  "enabledByDefault": false,
  "contributes": {
    "commands": [
      {"id": "library.open", "label": "Open Library", "icon": "bookshelf"}
    ],
    "views": [
      {"id": "library", "label": "Library", "icon": "bookshelf"}
    ],
    "sidebarItems": [
      {"id": "library-sidebar", "label": "Library", "icon": "bookshelf", "viewId": "library"}
    ]
  }
}
