# ===========================================
# Notees Configuration
# ===========================================
# Copy this file to .env and update with your values.

# ===========================================
# Docker User/Group IDs
# ===========================================
# Set these to match your host user to avoid permission issues
# on bind-mounted volumes (.config/)
# Get your IDs with: id -u && id -g
PUID=1000
PGID=1000

# ===========================================
# REQUIRED - Security
# ===========================================

# SECRET_KEY - REQUIRED, minimum 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This key is used for JWT signing and must be kept secret.
# WARNING: Never commit this file or .env to version control!
SECRET_KEY=your-secure-secret-key-here

# Optional - Admin user password (if not set, random password is generated on first run)
# IMPORTANT: If you don't set this, a random password will be generated on first startup.
# The password is NOT printed to logs for security reasons.
# To retrieve or change it later, set this env var and restart.
ADMIN_PASSWORD=

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# ===========================================
# CORS Configuration
# ===========================================

# CORS Origins - Comma-separated list of allowed origins
# Leave empty to disable CORS, use "*" only for development
# NEVER use "*" in production - it's a security risk!
# Example: CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=http://localhost:5173

# ===========================================
# Server Configuration
# ===========================================

HOST=0.0.0.0
PORT=8000
RELOAD=true

# ===========================================
# Database
# ===========================================

# PostgreSQL connection URL (REQUIRED)
# Format: postgresql://username:password@host:port/database
# For production, use a strong password and consider connection pooling
DATABASE_URL=postgresql://user:password@localhost:5432/notees

# Docker Compose Postgres credentials (used by postgres service in compose.yaml)
POSTGRES_USER=notees
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=notees

# ===========================================
# Backup
# ===========================================

# Backup interval in seconds (default: 3600 = 1 hour)
# Requires PostgreSQL client tools to be installed:
#   - Ubuntu/Debian: apt install postgresql-client
#   - macOS: brew install postgresql
#   - Windows: Install from postgresql.org
BACKUP_INTERVAL_SECONDS=3600

# Maximum number of backup files to keep (oldest are deleted automatically)
MAX_BACKUPS=50

# ===========================================
# Logging
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (will be created if doesn't exist)
LOG_FILE=logs/notees.log
