# Notees v2 environment configuration (production).
# compose reads this automatically. Copy from .env.example and adjust.

# Ports
NOTEES_SYNC_PORT=8377
NOTEES_WEB_PORT=8378

# Origins allowed to call the API from a browser (comma-separated, or *).
# Default * is safe for this stack: auth is header-based (Bearer/API key),
# there are no cookies to leak, so CORS is not a credential boundary here.
NOTEES_CORS_ORIGIN=*

# The server URL as the BROWSER reaches it (baked into the web UI's runtime config).
# Use the host's LAN IP or domain for non-local access, e.g. http://192.168.1.10:8377
NOTEES_SERVER_URL=http://localhost:8377
