"""Example environment configuration file.

Copy this file to .env and update with your values.
"""

# ===========================================
# Security - REQUIRED
# ===========================================

# SECRET_KEY - REQUIRED, minimum 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional - Admin user password (if not set, random password is generated on first run)
# SAVE THE GENERATED PASSWORD from logs if you don't set this
ADMIN_PASSWORD=

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# ===========================================
# CORS Configuration
# ===========================================

# CORS Origins - Comma-separated list of allowed origins
# Leave empty to disable CORS
# Use "*" ONLY for development (insecure for production)
# Example for production: CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=http://localhost:5173

# ===========================================
# Server Configuration
# ===========================================

HOST=0.0.0.0
PORT=8000
RELOAD=true

# ===========================================
# Database
# ===========================================

DATABASE_DIR=data

# ===========================================
# Backup
# ===========================================

BACKUP_INTERVAL_SECONDS=3600
MAX_BACKUPS=50

# ===========================================
# Logging
# ===========================================

LOG_LEVEL=INFO
LOG_FILE=logs/notees.log
