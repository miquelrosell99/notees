# Notees environment configuration — EXAMPLE. Copy to .env and adjust; .env
# is gitignored and never committed (fleet rule). Per the
# fleet-agnostic rule (AGENTS.md), this template must not carry real host
# names or IPs — the values below are generic examples, not your host.

# --- Port binds -------------------------------------------------------------
# Full ip:port publishing (compose `ports:`), one env per service. Defaults
# in compose.example.yaml publish 0.0.0.0 (all interfaces); pin loopback and
# re-expose the LAN through your edge/reverse proxy on production hosts.
#NOTEES_SYNC_HTTP=127.0.0.1:8377
#NOTEES_WEB_HTTP=127.0.0.1:8378
# Dev-stack example values (compose.dev.example.yaml): 127.0.0.1:8379 /
# 127.0.0.1:8380 — never collide with the prod ports on a shared host.

# --- Data dir ---------------------------------------------------------------
# The sync server's data dir (relay.db = THE authority). Defaults to the
# repo-local ./config/notees/sync; hosts keeping the dataset at a managed
# location (fleet stacks folder, a backed-up volume) override it here.
#NOTEES_DATA_DIR=./config/notees/sync

# --- API access -------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated, or *).
# Default * is safe for this stack: auth is header-based (Bearer/API key),
# there are no cookies to leak, so CORS is not a credential boundary here.
NOTEES_CORS_ORIGIN=*

# Open registration (default off): when set to true/1/yes/on, visitors can
# create their own (non-admin) accounts from the login screen's "Create one"
# link. Off → the signup route answers 404 and the link stays hidden.
#NOTEES_SIGNUP_ENABLED=true

# Optional sync-URL prefill for the web UI's runtime config (/config.js).
# Standard same-host :8377 topologies need NO value — the web client guesses
# protocol//hostname:8377 from its own origin and is right on LAN and tailnet
# alike (deployment.md). Set it only for non-standard sync placements;
# Tailscale HTTPS topologies: https://<host>.<tailnet>.ts.net:8377. Dev
# stacks: http://localhost:8379 (compose.dev.example.yaml pre-fills it).
#NOTEES_SERVER_URL=

# Optional Tailscale HTTPS edge (Caddy) — the "edge" compose profile. The
# tailnet hostname certificates issue/renew for, via the mounted tailscaled
# socket (compose.example.yaml). Generic placeholder — real value only in
# .env:
#NOTEES_EDGE_NAME=<host>.<tailnet>.ts.net
# Optional edge HTTPS port remap (default 8443):
#NOTEES_EDGE_HTTP=8443
