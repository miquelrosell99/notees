"""Example environment configuration file.

Copy this file to .env and update with your values.
"""

# ===========================================
# Security - REQUIRED
# ===========================================

# SECRET_KEY - REQUIRED, minimum 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional - Admin user password (if not set, random password is generated on first run)
# SAVE THE GENERATED PASSWORD from logs if you don't set this
ADMIN_PASSWORD=

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# ===========================================
# CORS Configuration
# ===========================================

# CORS Origins - Comma-separated list of allowed origins
# Leave empty to disable CORS
# Use "*" ONLY for development (insecure for production)
# Example for production: CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=http://localhost:5173

# ===========================================
# Server Configuration
# ===========================================

HOST=0.0.0.0
PORT=8000
RELOAD=true

# ===========================================
# Database
# ===========================================

# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://notees:change_me_dev_password@localhost:5432/notees

# Legacy setting (not used with PostgreSQL)
DATABASE_DIR=data

# ===========================================
# Backup
# ===========================================

# Backup interval in seconds (default: 3600 = 1 hour)
# Requires pg_dump to be installed (postgresql-client)
BACKUP_INTERVAL_SECONDS=3600

# Maximum number of backup files to keep (oldest are deleted)
MAX_BACKUPS=50

# ===========================================
# Logging
# ===========================================

LOG_LEVEL=INFO
LOG_FILE=logs/notees.log
