# ===========================================
# Notees — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

## Docker — User/Group IDs
# Match your host user to avoid permission issues on .config/ volumes
# Get IDs with: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/Madrid

## Security — REQUIRED
# Generate a strong secret key (min 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Initial admin password. If empty, a random password is generated on first
# startup. It is NOT printed to logs — set this if you want a known password.
ADMIN_PASSWORD=

## Database — REQUIRED
# Used by both the postgres container and the app (via compose.yaml)
POSTGRES_USER=notees
POSTGRES_PASSWORD=
POSTGRES_DB=notees

## Real-time Collaboration — Optional
# Redis URL for cross-instance WebSocket broadcast.
# Defaults to redis://localhost:6379/0. In Docker Compose, set via backend service env.
# REDIS_URL=redis://redis:6379/0

## Features — Optional (uncomment to override defaults)
# BACKUP_INTERVAL_SECONDS=3600
# MAX_BACKUPS=50
# ACCESS_TOKEN_EXPIRE_HOURS=168
# LOG_LEVEL=INFO
