# ===========================================
# Notees — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

## Docker — User/Group IDs
# Match your host user to avoid permission issues on .config/ volumes
# Get IDs with: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/Madrid

## Security — REQUIRED
# Generate a strong secret key (min 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Initial admin password. If set and no admin exists on startup, an admin user
# is created automatically with this password. The password must be at least 12
# characters long and contain uppercase, lowercase, digit, and special characters.
# If empty, or if set but does not meet these requirements, and no admin exists,
# the instance stays locked; both automatic admin creation and first-boot
# registration are rejected until a valid ADMIN_PASSWORD is set and the server is
# restarted, or until you run
#   python scripts/promote_user_to_admin.py <email>
# to bootstrap the first admin manually.
# When first-boot registration is allowed, the registrant must supply this exact
# ADMIN_PASSWORD in the registration request; the first admin is created with
# ADMIN_PASSWORD, not with the registrant's chosen password.
ADMIN_PASSWORD=

## Database — REQUIRED
# Used by the postgres container and the local backend.
# Notees uses non-default ports (5433/6380) so it can coexist with other local Postgres/Redis instances.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=notees
POSTGRES_PASSWORD=
POSTGRES_DB=notees

## Real-time Collaboration — Optional
# Redis URL for cross-instance WebSocket broadcast.
# Defaults to redis://localhost:6380/0 when running services locally with Docker Compose.
# REDIS_URL=redis://localhost:6380/0

## Frontend Development — Optional
# Comma-separated list of hostnames allowed by the Vite dev server. Add your local
# machine hostname (e.g. my-host) if you access the dev server from a remote host.
# If you connect through Tailscale, include the MagicDNS name (e.g. atlas.ts.net).
# After changing this value, recreate the frontend container:
#   docker compose -f compose.dev.yaml up -d --force-recreate frontend
# Example: VITE_ALLOWED_HOSTS=localhost,atlas,atlas.ts.net
VITE_ALLOWED_HOSTS=localhost

# Direct WebSocket URL for live sync. When unset, the app uses the current page host
# (which works through the Vite dev proxy in Docker Compose). Set this if the proxy
# cannot upgrade WebSocket connections, e.g. VITE_WS_URL=ws://my-server:8000
# VITE_WS_URL=

## Email / SMTP — Optional (needed for email invitations)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notees@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=true
# SMTP_FROM=notees@example.com
# PUBLIC_URL=https://notees.example.com

## Push Notifications — Optional (needed for mobile push delivery)
# FCM_SERVER_KEY=your-firebase-legacy-server-key
# For FCM HTTP v1, replace the adapter in app/infrastructure/push/fcm.py.

## Server — Optional
# Port for the local FastAPI backend. 8001 is used by default to avoid conflicts
# with common services on port 8000 (e.g. Paperless-ngx, other FastAPI apps).
PORT=8001

# Set to "production" to enable HSTS/HTTPS redirect and disable auto-reload.
# ENVIRONMENT=production

## Features — Optional (uncomment to override defaults)
# BACKUP_INTERVAL_SECONDS=3600
# MAX_BACKUPS=50
# ACCESS_TOKEN_EXPIRE_HOURS=1
# REFRESH_TOKEN_EXPIRE_DAYS=7
# REFRESH_TOKEN_REMEMBER_ME_DAYS=90
# LOG_LEVEL=INFO

## Data Retention — Optional (workspace settings override these defaults)
# DEFAULT_TRASH_RETENTION_DAYS=30
# ACTIVITY_LOG_RETENTION_ENABLED=true
# ACTIVITY_LOG_RETENTION_DAYS=90
# TASK_COMPLETION_RETENTION_ENABLED=true
# TASK_COMPLETION_RETENTION_DAYS=365

REGISTRATION_ENABLED=false
