# Web-only image: static frontend, no backend required.
# Serves the built SPA with nginx and generates /config.js at container start
# from NOTEES_SERVER_URL (empty/unset = local-only mode, sync disabled).
#
# Build:  docker build -f Dockerfile.web -t notees-web .
# Run:    docker run -p 8080:80 notees-web
#         docker run -p 8080:80 -e NOTEES_SERVER_URL=https://notes.example.com notees-web

# ==========================================
# Stage 1: Build Frontend
# ==========================================
FROM node:22-alpine@sha256:e58326d0d441090181ac150dc2078d3e2cf6a0d42e809aebba3ef5880935ffdd AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ ./
RUN npm run build -- --outDir ./dist

# ==========================================
# Stage 2: Static nginx
# ==========================================
FROM nginx:1.27-alpine AS production

COPY frontend/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Generate /config.js from the environment at container start. The default
# (empty NOTEES_SERVER_URL) opts the client into local-only mode.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'CONFIG=/usr/share/nginx/html/config.js' \
    'if [ -z "${NOTEES_SERVER_URL:-}" ]; then' \
    '  printf "// local-only mode (no server configured)\nwindow.__NOTEES_SERVER_URL__ = \"\";\n" > "$CONFIG"' \
    'else' \
    '  printf "// preconfigured sync server\nwindow.__NOTEES_SERVER_URL__ = \"%s\";\n" "$NOTEES_SERVER_URL" > "$CONFIG"' \
    'fi' \
    'exec nginx -g "daemon off;"' \
    > /docker-entrypoint.d/99-notees-config.sh \
    && chmod +x /docker-entrypoint.d/99-notees-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1
