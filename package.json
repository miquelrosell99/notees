{
  "name": "notees",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./packages/*\" publish"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12"
    }
  }
}
